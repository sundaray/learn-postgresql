# Copy to `.env` and fill in. One file serves both Alchemy stages:
# `pnpm dev` runs the "dev" stage on localhost, `pnpm deploy:prod` runs "prod".
# Every value below except ADMIN_EMAILS is required; a blank one fails the
# stack program rather than reaching Cloudflare as an empty string.
#
# See AUTH_SETUP.md for how to create the Google OAuth client and the SES
# sender that GOOGLE_* and AWS_*/SES_* refer to.

# Cloudflare account credentials used by Alchemy during plan and deploy.
# Scope the token to this account with: Workers Scripts Write, D1 Write,
# Account Settings Write, and Secrets Store Write. The last permission is
# required by Cloudflare.state(). Never commit the real values; `.env` is
# gitignored.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Authentication ---------------------------------------------------------

# Signs session cookies and OTP tokens. Any long random string:
# `openssl rand -base64 32`. Changing it signs every user out.
BETTER_AUTH_SECRET=

# The origin the app is served from, with no trailing slash. Used as the base
# for the logo URL in the login-code email, and it must match the origin your
# Google OAuth client authorizes. Use http://localhost:3000 while running
# `pnpm dev`; switch to the deployed https origin for prod.
BETTER_AUTH_URL=

# Comma-separated. Accounts created with one of these addresses get the "admin"
# role, which unlocks /admin and impersonation. The role is set once, when the
# account is first created, so adding an address here does not promote a user
# who already signed up. Leave blank for no admins.
ADMIN_EMAILS=

# Google OAuth client (Google Cloud console, "Web application"). The authorized
# redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google, so a client used
# for both local and deployed sign-in needs both URIs listed on it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Amazon SES sends the one-time login codes. SES_FROM_EMAIL has to be a verified
# identity in this region, and while the account is in the SES sandbox every
# recipient must be verified too. The IAM user needs ses:SendEmail.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
